from .models import Avatar


def escolher_avatar(request):

    profile = request.user.profile


    avatars = Avatar.objects.filter(

        classe=profile.classe,

        level_minimo__lte=profile.level

    )


    if request.method == "POST":

        avatar_id = request.POST.get(
            "avatar"
        )


        avatar = Avatar.objects.get(
            id=avatar_id
        )


        profile.avatar = avatar

        profile.save()


        return redirect("perfil")


    return render(

        request,

        "usuario_realms/avatar.html",

        {
            "avatars": avatars
        }

    )





from django.contrib.auth.models import User
from django.db import models
# =========================================================
# AVATARES DISPONÍVEIS
# =========================================================

class Avatar(models.Model):

    GENERO_PERSONAGEM_CHOICES = [
        ('feminino', 'Feminino'),
        ('masculino', 'Masculino'),
    ]

    CLASSE_CHOICES = [

        ('iniciante', 'Iniciante'),

        ('mago', 'Mago'),

        ('guerreiro', 'Guerreiro'),

        ('assassino', 'Assassino'),

        ('clerigo', 'Clérigo'),

    ]


    nome = models.CharField(
        max_length=50
    )


    imagem = models.CharField(
        max_length=100
    )


    classe = models.CharField(
        max_length=20,
        choices=CLASSE_CHOICES
    )

    genero_personagem = models.CharField(
        max_length=20,
        choices=GENERO_PERSONAGEM_CHOICES
    )

    level_minimo = models.IntegerField(
        default=1
    )


    def __str__(self):

        return self.nome


