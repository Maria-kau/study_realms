
    <div class="lado-direito">
        <div class="profile-avatar">
            <img src="{{ user.avatar.url }}" alt="avatar-inteiro">
        </div>
    </div>

    <div class="lado-esquerdo">
        <div class="infor-dados">
            <div class="perfil">
                <div class="lado-esquerdo">
                    <img src="{{ user.avatar.url }}" alt="avatar-miniatura">
                </div>
                <div class="lado-direito">
                    <h2>{{ user.username }}</h2>
                    
                </div>
            </div>
            
        </div>
    </div>
    






    
    <div class="profile-card">

    <div class="profile-header">
        <div class="avatar">
            <img src="{{ user.avatar.url }}" alt="avatar">
        </div>

        <div class="profile-info">
            <h2>{{ user.username }}</h2>
            <p class="classe">{{ user.classe_personagem }}</p>
            <p class="genero">{{ user.genero_usuario }}</p>
        </div>
    </div>

    <div class="stats">

        <div class="stat">
            <span>Nível</span>
            <strong>{{ user.level }}</strong>
        </div>

        <div class="stat">
            <span>XP</span>
            <strong>{{ user.xp }}</strong>
        </div>

        <div class="stat">
            <span>Horas de estudo</span>
            <strong>{{ user.horas_estudo }}h</strong>
        </div>

    </div>

    <div class="objective">
        <h3>Objetivo</h3>
        <p>{{ user.objetivo }}</p>
    </div>

</div>