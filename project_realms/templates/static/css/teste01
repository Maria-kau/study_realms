/* ===== LOGO ===== */

.logo{
    width: 100%;

    display: flex;
    align-items: center;
    gap: 15px;

    padding: 10px 0;
}

/* imagem */

.img-logo img{
    width: 70px;

    object-fit: cover;
}

/* texto */

.texto-logo{
    display: flex;
    flex-direction: column;
}

.texto-logo h1{
    color: #fff;

    font-size: 1.7rem;

    font-family: 'Cinzel Decorative', cursive;

    margin: 0;
}

.texto-logo p{
    color: #cfcfff;

    font-size: 0.7rem;

    margin: 0;
}

/* ===== RESPONSIVIDADE ===== */

@media (max-width: 768px){

    .logo{
        justify-content: center;

        text-align: center;

        flex-direction: column;
    }

    .img-logo img{
        width: 60px;
    }

    .texto-logo h1{
        font-size: 1.4rem;
    }

    .texto-logo p{
        font-size: 0.65rem;
    }
}

@media (max-width: 480px){

    .img-logo img{
        width: 50px;
    }

    .texto-logo h1{
        font-size: 1.1rem;
    }

    .texto-logo p{
        font-size: 0.55rem;
    }
}