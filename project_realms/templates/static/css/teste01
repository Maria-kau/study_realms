.menu-lateral{
    width: 260px;
    height: 100vh;
    background: #0b1020;
    border-right: 1px solid rgba(255,255,255,0.05);

    display: flex;
    flex-direction: column;
    align-items: center;

    padding: 20px;
    gap: 25px;
}

/* LOGO */

.logo-menu{
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
}

.icone-logo{
    width: 45px;
    height: 45px;
    border-radius: 12px;

    background: linear-gradient(
        135deg,
        #7b5cff,
        #5ce1ff
    );
}

.logo-menu h1{
    color: white;
    font-size: 22px;
}

/* PERFIL */

.perfil-menu{
    width: 100%;
    padding: 15px;

    border-radius: 20px;

    background: rgba(255,255,255,0.03);

    display: flex;
    align-items: center;
    gap: 15px;
}

.perfil-menu img{
    width: 60px;
    height: 60px;
    border-radius: 50%;

    object-fit: cover;

    border: 2px solid #7b5cff;
}

.info-perfil h2{
    color: white;
    font-size: 18px;
}

.info-perfil p{
    color: #9e8cff;
    font-size: 14px;
}

/* LISTA */

.lista-menu{
    width: 100%;
    list-style: none;

    display: flex;
    flex-direction: column;
    gap: 10px;
}

.lista-menu a{
    width: 100%;
    padding: 14px 18px;

    display: flex;
    align-items: center;
    gap: 12px;

    text-decoration: none;

    border-radius: 15px;

    color: #c7c7d9;

    transition: 0.3s;
}

.lista-menu a:hover{
    background: rgba(123,92,255,0.15);

    color: white;

    transform: translateX(5px);
}



/*====================fundo====================*/
.fundo {
    position:absolute;
    width: 100vw;
    height: 100vh;
    background-image: url("../img/mapa3.jpeg");
    display: flex;
    justify-content: center;
    align-items: center;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    flex-direction: column;
    overflow: hidden;
    z-index: 1;
    padding: 10px 5px;
}
/*==================superior===================*/
.superior {
    width: 100%;
    height: 12%;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-direction: row;
    position: relative;
    background-position: center top;   
}
/*=====esquerdo=====*/
.superior-esquerdo{
    height: 100%;
    width: 40%;
    display: flex;
    justify-content: center;
    align-items: center;
}

.titulo{
    height: 100%;
    width: 100%;
    display: flex;
    justify-content: flex-start;
    align-items: center;
}

.emblema, .menu{
    height: 80%;
    width: 10%;
  
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 5px;
    z-index: 3;
    backdrop-filter: 10px;
    border-radius: 25px;
}

.emblema{
    height: 100%;
    width: 18%;
}

.ico-menu{
    background-image: url("../img/menu.png");  
    padding: 30px;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
}

.ico-emblema{
    background-image: url("../img/ico-titulo1.png");
    padding: 45px;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    filter:
        drop-shadow(0 0 8px #00def7a0)
        drop-shadow(0 0 20px #031cff8c);
}

.titulo-area{
    height: 100%;
    width: 60%;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    z-index: 3;
}

.titulo-area p {
    margin: 0px 0px 0px 30px;/* baico esquerda cima direita*/
}
/*======direito=====*/
.superior .direito{
    height: 100%;
    width: 70%;
    display: flex;
    justify-content: flex-start;
    align-items: flex-end; 
    padding: 0px 0px 0px 100px;
}

.barra-progresso{
    height: 90%;
    width: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 5px;
}

.barra-progresso h3{
    margin: 5px;
    font-size: 12px;
}

.sequencia, .area-player{
    height: 100%;
    width: 25%;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-direction: column;
    margin: 0;
}

.zona-sequencia{
    height: 100%;
    width: 100%;
    z-index: 3; 
    display: flex;
}

.area-player{
    width: 50%;
}

.progresso-sequencia, .progresso-aura, .progresso-zona{
    height: 100%;
    width: 100%;
    z-index: 3; 
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-direction: row;
}

.progresso-sequencia{
    height: 100%;
    width: 50%;
    background-image: url("../img/ico.xp.png");
    background-position: center;
    background-size: contain;
    background-repeat: no-repeat;
    margin: 0 0 20px 10px;
}

.progresso-aura{
    height: 90%;
    width: 50%;
    background-image: url("../img/ico.aura.png");
    background-position: center;
    background-size: contain;
    margin: 0 0 15px 10px;
}
/*====================meio=====================*/
.meio {
    width: 100%;
    height: 68%;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: row;
}
/*=====esquerdo=====*/
.meio .esquerdo{
    height: 100%;
    width: 30%;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    flex-direction: column;
    padding: 10px 10px 10px 30px;
    gap: 10px;
}

.fixa-estudo, .cronometro, .list-dia{
    height: 30%;
    width: 65%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 8px 0px 0px 0px;
}

.fixa-estudo{
    flex-direction: column;
}

.list-dia{
    height: 40%;
}

.card-assunto{
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 10px 0px 0px 0px;
}

.ico-assunto{
    width: 40%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
}

.fixa{
    width: 60%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
}
/*--------------------meio centro-------------*/
.meio .centro{
    height: 100%;
    width: 40%;
    display: flex;
    justify-content: flex-start;
    align-items: center;
}
#mapa{
    z-index: 3;
}
.tile{ 
    position: absolute; 
    width: 50px; 
    height: 25px; 
    transform: rotate(0.5deg); 
    clip-path: polygon( 50% 0%, 100% 50%, 50% 100%, 0% 50% );
    border: 0.5px solid rgba(9,97,69,0.28);  
    transition: filter 0.2s; 
    z-index: 4;
} 
.tile:hover{ 
    filter: brightness(1.2); 
    cursor: pointer; 
}
 
 .arvore{ 
    background-image: url("../img/arvore.png"); 
    position: absolute; 
    width: 60px; 
    height: 70px; 
    background-size: contain; 
    background-repeat: no-repeat; 
    background-position: bottom center; 
    pointer-events: none;
    z-index: 5; 
    transform-origin: bottom center; 
    animation: vento 3s ease-in-out infinite alternate; 
} 

@keyframes vento{ 
    0%{ transform: rotate(-1deg) skewX(1deg); } 
    100%{ transform: rotate(2deg) skewX(-1deg); } 
}
/*======direito=====*/
.meio .direito{
    height: 100%;
    width: 30%;
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    flex-direction: column;
    gap: 20px;
    padding: 10px 30px 10px 10px;
}
.perfil, .progresso{
    height: 25%;
    width: 65%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 10px;
}
.progresso{
    height: 55%;
}

